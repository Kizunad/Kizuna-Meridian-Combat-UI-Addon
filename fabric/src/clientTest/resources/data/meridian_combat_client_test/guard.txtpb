schema_version: 1
namespace: "meridian_combat_client_test"
binding_templates { id: "human:adult" version: 1 }
definitions {
  id: "meridian_combat_client_test:practice"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  cost {}
  phases { warmup_millis: 100 active_millis: 0 recovery_millis: 0 interruptible_by_damage: true }
  cooldown_millis: 0
  maintained_breathing {
    effect_id: "meridian_combat_client_test:practice"
    color_rgb: 3178400
    qi_per_second: 0.005
    factors { intake_multiplier: 1.5 respiratory_work_multiplier: 0.5 }
  }
  presentation { display_name: "运功验收" }
}
definitions {
  id: "meridian_combat_client_test:guard"
  version: 1
  category: DEFENSE
  minimum_realm: WANDERING_QI
  cost {}
  phases {
    warmup_millis: 200
    active_duration: ACTIVE_DURATION_UNTIL_RELEASE
    recovery_millis: 300
    interruptible_by_damage: true
  }
  cooldown_millis: 0
  innate: true
  effects {
    at_millis: 200
    guard {
      angle { value: 120 unit: DEGREE }
      damage_multiplier { value: 0.7 unit: RATIO }
      damage_tags: "minecraft:is_projectile"
    }
  }
  ai_hints {
    minimum_distance { value: 0 unit: METER }
    maximum_distance { value: 1 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    support { role: AI_ROLE_GUARD }
  }
  presentation {
    display_name: "输入验收守式"
    description: "客户端测试专用，不随正式模组发布。"
  }
}
